<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnimaWindows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="animawindows">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="animawindows"
            BackRequested="OnBackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.targetsize-24.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="GlobalSearch"
                    x:Uid="Shell_Search"
                    MaxWidth="{StaticResource SearchBoxMaxWidth}"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="GlobalSearchBox"
                    GotFocus="OnSearchGotFocus"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    SuggestionChosen="OnSearchSuggestionChosen"
                    TextChanged="OnSearchTextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AutomationProperties.AutomationId="MainNavigation"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeItem"
                    x:Uid="Nav_Home"
                    AutomationProperties.AutomationId="NavHome"
                    Icon="Home"
                    Tag="home" />
                <NavigationViewItem
                    x:Name="SearchItem"
                    x:Uid="Nav_Search"
                    AutomationProperties.AutomationId="NavSearch"
                    Icon="Find"
                    Tag="search" />
                <NavigationViewItem
                    x:Name="DownloadsItem"
                    x:Uid="Nav_Downloads"
                    AutomationProperties.AutomationId="NavDownloads"
                    Icon="Download"
                    Tag="downloads" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <InfoBar
            x:Name="UpdateBar"
            Grid.Row="1"
            MaxWidth="{StaticResource UpdateBarMaxWidth}"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="UpdateBar"
            Closed="OnUpdateBarClosed"
            IsClosable="True"
            Severity="Informational">
            <InfoBar.ActionButton>
                <HyperlinkButton
                    x:Name="ChangelogLink"
                    x:Uid="Update_Changelog"
                    AutomationProperties.AutomationId="UpdateChangelogLink" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
