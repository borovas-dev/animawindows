<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AnimaWindows.App.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AnimaWindows.App.Converters">

    <StackPanel Width="{StaticResource PosterCardWidth}" Spacing="8">
        <Grid
            x:Name="PosterHost"
            Height="{StaticResource PosterImageHeight}"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE714;" />
            <Image Source="{x:Bind conv:Fx.Image(CoverUrl, 320), Mode=OneWay}" Stretch="UniformToFill" />
            <ProgressBar
                VerticalAlignment="Bottom"
                Maximum="100"
                Value="{x:Bind Progress, Mode=OneWay}"
                Visibility="{x:Bind conv:Fx.VisibleIfNonNegative(Progress), Mode=OneWay}" />
        </Grid>
        <TextBlock
            MaxLines="2"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />
        <TextBlock
            Style="{StaticResource SecondaryTextStyle}"
            Text="{x:Bind Caption, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind conv:Fx.VisibleIfText(Caption), Mode=OneWay}" />
    </StackPanel>
</UserControl>
