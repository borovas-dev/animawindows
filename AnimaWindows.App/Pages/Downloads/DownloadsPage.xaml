<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnimaWindows.App.Pages.Downloads.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AnimaWindows.App.Pages.Downloads"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="EpisodeTemplate" x:DataType="local:DownloadEpisodeViewModel">
            <Grid
                Padding="12,8"
                Background="Transparent"
                ColumnSpacing="12"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="Downloads_Play" Command="{x:Bind OpenCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Downloads_Pause" Command="{x:Bind PauseCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE769;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Downloads_Resume" Command="{x:Bind ResumeCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Downloads_Retry" Command="{x:Bind RetryCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Downloads_OpenFolder" Command="{x:Bind OpenFolderCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE838;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Downloads_Delete" Command="{x:Bind DeleteCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Maximum="100"
                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                        Value="{x:Bind ProgressValue, Mode=OneWay}"
                        ShowPaused="{x:Bind IsPaused, Mode=OneWay}"
                        ShowError="{x:Bind IsFailed, Mode=OneWay}"
                        Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        x:Uid="Downloads_Play"
                        AutomationProperties.AutomationId="DownloadPlayButton"
                        Command="{x:Bind OpenCommand}"
                        Visibility="{x:Bind CanOpen, Mode=OneWay}">
                        <FontIcon Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Uid="Downloads_Pause"
                        AutomationProperties.AutomationId="DownloadPauseButton"
                        Command="{x:Bind PauseCommand}"
                        Visibility="{x:Bind CanPause, Mode=OneWay}">
                        <FontIcon Glyph="&#xE769;" />
                    </Button>
                    <Button
                        x:Uid="Downloads_Resume"
                        AutomationProperties.AutomationId="DownloadResumeButton"
                        Command="{x:Bind ResumeCommand}"
                        Visibility="{x:Bind CanResume, Mode=OneWay}">
                        <FontIcon Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Uid="Downloads_Retry"
                        AutomationProperties.AutomationId="DownloadRetryButton"
                        Command="{x:Bind RetryCommand}"
                        Visibility="{x:Bind CanRetry, Mode=OneWay}">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        x:Uid="Downloads_OpenFolder"
                        AutomationProperties.AutomationId="DownloadOpenFolderButton"
                        Command="{x:Bind OpenFolderCommand}">
                        <FontIcon Glyph="&#xE838;" />
                    </Button>
                    <Button
                        x:Uid="Downloads_Delete"
                        AutomationProperties.AutomationId="DownloadDeleteButton"
                        Command="{x:Bind DeleteCommand}">
                        <FontIcon Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="local:DownloadGroupViewModel">
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="64"
                            Height="90"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                MaxLines="2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind SummaryText, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            x:Uid="Downloads_DeleteAll"
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="DownloadDeleteGroupButton"
                            Command="{x:Bind DeleteAllCommand}">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                    <ItemsControl
                        Grid.Row="1"
                        ItemTemplate="{StaticResource EpisodeTemplate}"
                        ItemsSource="{x:Bind Episodes}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Downloads_Title" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Uid="Downloads_WaitingForNetwork"
                AutomationProperties.AutomationId="DownloadsWaitingInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsWaitingForNetwork, Mode=OneWay}"
                Severity="Informational" />
            <InfoBar
                x:Uid="Downloads_ErrorBar"
                AutomationProperties.AutomationId="DownloadsErrorInfoBar"
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl
                ItemTemplate="{StaticResource GroupTemplate}"
                ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                x:Uid="Downloads_EmptyTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="Downloads_EmptyBody"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
