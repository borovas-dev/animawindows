<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnimaWindows.App.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:tracking="using:AnimaWindows.App.Controls.Tracking"
    xmlns:vm="using:AnimaWindows.App.ViewModels">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource SettingsMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="4">
            <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar AutomationProperties.AutomationId="SettingsStatusBar" IsClosable="True" IsOpen="{x:Bind ViewModel.HasStatus, Mode=TwoWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />
            <TextBlock x:Uid="Settings_Group_Playback" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsCard x:Uid="Settings_Quality" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE714;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Uid="Settings_Quality_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsQuality" ItemsSource="{x:Bind ViewModel.QualityNames}" SelectedIndex="{x:Bind ViewModel.QualityIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Autoplay" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE893;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Uid="Settings_Autoplay_Ctl" AutomationProperties.AutomationId="SettingsAutoplay" IsOn="{x:Bind ViewModel.AutoPlayNext, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander x:Uid="Settings_Prefetch" >
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE72C;" /></toolkit:SettingsExpander.HeaderIcon>
            <ToggleSwitch x:Uid="Settings_Prefetch_Ctl" AutomationProperties.AutomationId="SettingsPrefetch" IsOn="{x:Bind ViewModel.PrefetchNextEpisode, Mode=TwoWay}" />
            <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard x:Uid="Settings_PrefetchMetered" >
            <ToggleSwitch x:Uid="Settings_PrefetchMetered_Ctl" AutomationProperties.AutomationId="SettingsPrefetchMetered" IsOn="{x:Bind ViewModel.PrefetchOnMetered, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard x:Uid="Settings_Engine" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Uid="Settings_Engine_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsEngine" ItemsSource="{x:Bind ViewModel.EngineNames}" SelectedIndex="{x:Bind ViewModel.EngineIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Audio" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE767;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Uid="Settings_Audio_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsAudio" ItemsSource="{x:Bind ViewModel.AudioNames}" SelectedIndex="{x:Bind ViewModel.AudioIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <TextBlock x:Uid="Settings_Group_Subtitles" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsCard x:Uid="Settings_SubtitleLanguage" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F0;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Uid="Settings_SubtitleLanguage_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsSubtitleLanguage" ItemsSource="{x:Bind ViewModel.SubtitleLanguageNames}" SelectedIndex="{x:Bind ViewModel.SubtitleLanguageIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <TextBlock x:Uid="Settings_Group_AniSkip" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsExpander x:Uid="Settings_AniSkip" >
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7C3;" /></toolkit:SettingsExpander.HeaderIcon>
            <ToggleSwitch x:Uid="Settings_AniSkip_Ctl" AutomationProperties.AutomationId="SettingsAniSkip" IsOn="{x:Bind ViewModel.AniSkipEnabled, Mode=TwoWay}" />
            <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard x:Uid="Settings_SkipBehavior" >
            <ComboBox x:Uid="Settings_SkipBehavior_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsSkipBehavior" ItemsSource="{x:Bind ViewModel.SkipBehaviorNames}" SelectedIndex="{x:Bind ViewModel.SkipBehaviorIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="{x:Bind ViewModel.SkipOffsetText, Mode=OneWay}">
            <Slider x:Uid="Settings_SkipOffset_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsSkipOffset" Maximum="5" Minimum="0" SnapsTo="StepValues" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" Value="{x:Bind ViewModel.SkipOffsetSec, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_AutoSkipIntro" >
            <ToggleSwitch x:Uid="Settings_AutoSkipIntro_Ctl" AutomationProperties.AutomationId="SettingsAutoSkipIntro" IsOn="{x:Bind ViewModel.AutoSkipIntro, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_AutoSkipOutro" >
            <ToggleSwitch x:Uid="Settings_AutoSkipOutro_Ctl" AutomationProperties.AutomationId="SettingsAutoSkipOutro" IsOn="{x:Bind ViewModel.AutoSkipOutro, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <TextBlock x:Uid="Settings_Group_Appearance" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsCard x:Uid="Settings_Theme" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Uid="Settings_Theme_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsTheme" ItemsSource="{x:Bind ViewModel.ThemeNames}" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <TextBlock x:Uid="Settings_Group_Downloads" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsCard x:Uid="Settings_WifiOnly" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE702;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Uid="Settings_WifiOnly_Ctl" AutomationProperties.AutomationId="SettingsWifiOnly" IsOn="{x:Bind ViewModel.DownloadWifiOnly, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_DownloadFolder" Description="{x:Bind ViewModel.DownloadDirectoryText, Mode=OneWay}">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></toolkit:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="Settings_ChooseFolder_Btn" AutomationProperties.AutomationId="SettingsChooseFolderButton" Command="{x:Bind ViewModel.ChooseDownloadFolderCommand}" />
            <Button x:Uid="Settings_ResetFolder_Btn" AutomationProperties.AutomationId="SettingsResetFolderButton" Command="{x:Bind ViewModel.ResetDownloadFolderCommand}" IsEnabled="{x:Bind ViewModel.HasCustomDownloadDirectory, Mode=OneWay}" />
            </StackPanel>
            </toolkit:SettingsCard>
            <TextBlock x:Uid="Settings_Group_Advanced" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsCard x:Uid="Settings_ContentLanguage" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Uid="Settings_ContentLanguage_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsContentLanguage" ItemsSource="{x:Bind ViewModel.ContentLanguageNames}" SelectedIndex="{x:Bind ViewModel.ContentLanguageIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Strategy" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Uid="Settings_Strategy_Ctl" MinWidth="{StaticResource SettingsComboWidth}" AutomationProperties.AutomationId="SettingsStrategy" ItemsSource="{x:Bind ViewModel.StrategyNames}" SelectedIndex="{x:Bind ViewModel.StrategyIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander x:Uid="Settings_Providers" AutomationProperties.AutomationId="SettingsProviders" Description="{x:Bind ViewModel.ProvidersDescription, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Providers}">
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE839;" /></toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderRowViewModel">
            <toolkit:SettingsCard Header="{x:Bind Name}">
            <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="Settings_MoveUp" Click="OnMoveProviderUp" IsEnabled="{x:Bind CanMoveUp}" Tag="{x:Bind}"><FontIcon Glyph="&#xE70E;" /></Button>
            <Button x:Uid="Settings_MoveDown" Click="OnMoveProviderDown" IsEnabled="{x:Bind CanMoveDown}" Tag="{x:Bind}"><FontIcon Glyph="&#xE70D;" /></Button>
            <ToggleSwitch AutomationProperties.Name="{x:Bind Name}" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
            </StackPanel>
            </toolkit:SettingsCard>
            </DataTemplate>
            </toolkit:SettingsExpander.ItemTemplate>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard x:Uid="Settings_Health" AutomationProperties.AutomationId="SettingsHealthLink" Command="{x:Bind ViewModel.OpenHealthCommand}" IsClickEnabled="True">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE95E;" /></toolkit:SettingsCard.HeaderIcon>
            
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_CheckUpdates" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Uid="Settings_CheckUpdates_Ctl" AutomationProperties.AutomationId="SettingsCheckUpdates" IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Prereleases" >
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Uid="Settings_Prereleases_Ctl" AutomationProperties.AutomationId="SettingsPrereleases" IsOn="{x:Bind ViewModel.IncludePrereleases, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander x:Uid="Settings_Backup" >
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8F1;" /></toolkit:SettingsExpander.HeaderIcon>
            
            <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard x:Uid="Settings_Export" >
            <Button x:Uid="Settings_Export_Btn" AutomationProperties.AutomationId="SettingsExportButton" Command="{x:Bind ViewModel.ExportBackupCommand}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Import" >
            <Button x:Uid="Settings_Import_Btn" AutomationProperties.AutomationId="SettingsImportButton" Command="{x:Bind ViewModel.ImportBackupCommand}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_ImportAniCli" >
            <Button x:Uid="Settings_ImportAniCli_Btn" AutomationProperties.AutomationId="SettingsImportAniCliButton" Command="{x:Bind ViewModel.ImportAniCliCommand}" />
            </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <TextBlock x:Uid="Settings_Group_Tracking" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <tracking:TrackingSection />
            <TextBlock x:Uid="Settings_Group_About" Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsExpander x:Uid="Settings_About" Description="{x:Bind ViewModel.VersionText}">
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE946;" /></toolkit:SettingsExpander.HeaderIcon>
            
            <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard x:Uid="Settings_UpdateStatus" Description="{x:Bind ViewModel.UpdateText, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
            <HyperlinkButton x:Uid="Settings_ReleasePage_Link" AutomationProperties.AutomationId="SettingsReleasePageLink" NavigateUri="{x:Bind ViewModel.UpdateLink, Mode=OneWay}" />
            <Button x:Uid="Settings_CheckNow_Btn" AutomationProperties.AutomationId="SettingsCheckNowButton" Command="{x:Bind ViewModel.CheckUpdatesCommand}" />
            </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_License" >
            <HyperlinkButton x:Uid="Settings_License_Link" AutomationProperties.AutomationId="SettingsLicenseLink" NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Credits" >
            <StackPanel Orientation="Horizontal" Spacing="4">
            <HyperlinkButton x:Uid="Settings_AniCli_Link" AutomationProperties.AutomationId="SettingsAniCliLink" NavigateUri="https://github.com/pystardust/ani-cli" />
            <HyperlinkButton x:Uid="Settings_AniSkip_Link" AutomationProperties.AutomationId="SettingsAniSkipLink" NavigateUri="https://github.com/synacktraa/ani-skip" />
            <HyperlinkButton x:Uid="Settings_Animadroid_Link" AutomationProperties.AutomationId="SettingsAnimadroidLink" NavigateUri="https://github.com/borovas-dev/animadroid" />
            </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Source" >
            <HyperlinkButton x:Uid="Settings_Source_Link" AutomationProperties.AutomationId="SettingsSourceLink" NavigateUri="https://github.com/borovas-dev/animawindows" />
            </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
