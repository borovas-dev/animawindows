<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AnimaWindows.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Single-project MSIX packaging -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- We provide Program.Main (single-instance redirection) in Shell/Program.cs. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- The WinUI/XAML toolchain emits warnings we cannot control; the libraries keep warnings-as-errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Tracker OAuth client ids; blank disables the tracker. Pass /p:AniListClientId=... /p:MalClientId=... -->
    <AniListClientId Condition="'$(AniListClientId)' == ''"></AniListClientId>
    <MalClientId Condition="'$(MalClientId)' == ''"></MalClientId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnimaWindows.Core\AnimaWindows.Core.csproj" />
    <ProjectReference Include="..\AnimaWindows.Providers\AnimaWindows.Providers.csproj" />
    <ProjectReference Include="..\AnimaWindows.Data\AnimaWindows.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Bundled fallback copy of the remote provider configuration (see Core.RemoteConfig). -->
  <ItemGroup>
    <Content Include="..\config\providers.json" Link="Assets\providers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tracker client ids from the AniListClientId / MalClientId MSBuild properties, read at runtime by Composition/TrackerIds. -->
  <ItemGroup>
    <AssemblyMetadata Include="AniListClientId" Value="$(AniListClientId)" />
    <AssemblyMetadata Include="MalClientId" Value="$(MalClientId)" />
  </ItemGroup>
  <!-- libmpv for the mpv fallback engine; fetched by CI (see .github/workflows/ci.yml), optional for local builds. -->
  <ItemGroup Condition="'$(Platform)'=='x64' And Exists('native\win-x64\libmpv-2.dll')">
    <Content Include="native\win-x64\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)'=='ARM64' And Exists('native\win-arm64\libmpv-2.dll')">
    <Content Include="native\win-arm64\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
