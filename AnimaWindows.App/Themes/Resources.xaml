<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout metrics (4 px grid). All hard-coded sizes of the shell pages live here. -->
    <x:Double x:Key="PageMaxWidth">1240</x:Double>
    <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
    <x:Double x:Key="SectionSpacing">24</x:Double>
    <x:Double x:Key="PosterCardWidth">160</x:Double>
    <x:Double x:Key="PosterImageHeight">240</x:Double>
    <x:Double x:Key="PosterGridItemWidth">176</x:Double>
    <x:Double x:Key="PosterGridItemHeight">344</x:Double>
    <x:Double x:Key="ContinueRowHeight">336</x:Double>
    <x:Double x:Key="HeroPosterWidth">160</x:Double>
    <x:Double x:Key="HeroPosterHeight">240</x:Double>
    <x:Double x:Key="HeroBackdropHeight">360</x:Double>
    <x:Double x:Key="SearchBoxMaxWidth">520</x:Double>
    <x:Double x:Key="EmptyStateMaxWidth">420</x:Double>
    <x:Double x:Key="EpisodeProgressWidth">96</x:Double>
    <x:Double x:Key="SettingsMaxWidth">1000</x:Double>
    <x:Double x:Key="UpdateBarMaxWidth">520</x:Double>
    <x:Double x:Key="ProviderComboWidth">220</x:Double>
    <x:Double x:Key="SettingsComboWidth">200</x:Double>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="PosterPlaceholderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
</ResourceDictionary>
